# Copy to backend/.env. No Google credentials are needed for local development.
ENVIRONMENT=development
AI_MODE=demo
ALLOW_DEMO_LOGIN=true
COOKIE_SECURE=false
# Defaults to backend/data/workspace.db; use an absolute path if overriding.
# DATABASE_URL=sqlite:////absolute/path/to/workspace.db
CORS_ORIGINS=http://localhost:3000
SESSION_HOURS=12

# Cloud mode is explicit. Errors never silently switch to demo mode.
# AI_MODE=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
DEFAULT_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20
# Optional aggregate-only analytics export; see docs/DEPLOYMENT.md.
BIGQUERY_DATASET=ai_ops_analytics
BIGQUERY_LOCATION=US

# Required production overrides:
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aiops
# AI_MODE=vertex (or disabled)
# ALLOW_DEMO_LOGIN=false
# COOKIE_SECURE=true
# CORS_ORIGINS=https://your-frontend.example

# For HTTPS previews embedded in another site's iframe only:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# COOKIE_PARTITIONED=true
# Default standalone deployments should keep COOKIE_SAMESITE=lax.
